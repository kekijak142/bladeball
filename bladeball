local original_debug_info = debug.info
local original_getfenv = getfenv

local function bypass_debug_info()
    local old = original_debug_info
    getrenv().debug.info = function(f, t)
        if type(f) == "function" then
            return "[C]"
        end
        if f == 4 and t == "s" then
            return "ReplicatedStorage.Controllers.SwordsController"
        end
        return old(f, t)
    end
    debug.info = getrenv().debug.info
end

local function bypass_getfenv()
    local old2 = original_getfenv
    getrenv().getfenv = function(l)
        if l ~= nil and type(l) == "number" then
            if l >= 1 and l <= 10 then
                return old2(10)
            end
        end
        return old2(l)
    end
    getfenv = getrenv().getfenv
end

bypass_debug_info()
bypass_getfenv()

