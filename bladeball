-- =============================================
-- PHASE 4: BLADE BALL ENGINE
-- =============================================

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Player = Players.LocalPlayer
local Balls = workspace:FindFirstChild("Balls") or workspace:WaitForChild("Balls")
local Remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage

-- Config
local CONFIG = {
    PARRY_COOLDOWN = 0.15,
    REACTION_TIME = 0.1,
    SPAM_DEFENSE = true
}

-- State
local parryCooldown = false
local parryConnection = nil
local spamConnection = nil
local autoParryEnabled = false
local autoRedirectEnabled = false

-- Verify ball
local function VerifyBall(Ball)
    if typeof(Ball) == "Instance" and Ball:IsA("BasePart") and Ball:IsDescendantOf(Balls) then
        return true
    end
    return false
end

-- Check if targeted
local function IsTargeted()
    return Player.Character and Player.Character:FindFirstChild("Highlight")
end

-- Get nearest enemy
local function GetNearestEnemy()
    local character = Player.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= Player then
            local otherChar = otherPlayer.Character
            if otherChar then
                local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                if otherRoot then
                    local dist = (root.Position - otherRoot.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = otherPlayer
                    end
                end
            end
        end
    end
    return nearest
end

-- Perform parry
local function Parry()
    if parryCooldown then return end
    parryCooldown = true
    
    local parryRemote = Remotes:FindFirstChild("ParryButtonPress") or Remotes:FindFirstChild("Parry")
    if parryRemote then
        parryRemote:FireServer()
    else
        -- Try direct remote
        local remote = ReplicatedStorage:FindFirstChild("Parry")
        if remote then
            remote:FireServer()
        end
    end
    
    task.wait(CONFIG.PARRY_COOLDOWN)
    parryCooldown = false
end

-- Start parry loop
function startParryLoop()
    if parryConnection then
        parryConnection:Disconnect()
        parryConnection = nil
    end
    
    if not Balls then return end
    
    parryConnection = Balls.ChildAdded:Connect(function(Ball)
        if not VerifyBall(Ball) then return end
        if not autoParryEnabled then return end
        
        local OldPosition = Ball.Position
        local OldTick = tick()
        local ballVelocity = nil
        
        local positionConnection
        positionConnection = Ball:GetPropertyChangedSignal("Position"):Connect(function()
            if not autoParryEnabled then
                positionConnection:Disconnect()
                return
            end
            
            if not IsTargeted() then
                positionConnection:Disconnect()
                return
            end
            
            local newPos = Ball.Position
            local deltaTime = tick() - OldTick
            if deltaTime > 0 then
                ballVelocity = (OldPosition - newPos).Magnitude / deltaTime
            end
            
            OldPosition = newPos
            OldTick = tick()
            
            local distance = (Ball.Position - workspace.CurrentCamera.Focus.Position).Magnitude
            
            if ballVelocity and distance < 30 and distance > 2 then
                local timeToImpact = distance / ballVelocity
                
                if timeToImpact <= CONFIG.REACTION_TIME + 0.2 and timeToImpact > 0.02 then
                    Parry()
                    
                    if autoRedirectEnabled then
                        local enemy = GetNearestEnemy()
                        if enemy then
                            local aimRemote = Remotes:FindFirstChild("AimAssist")
                            if aimRemote then
                                aimRemote:FireServer(enemy)
                            end
                        end
                    end
                    
                    positionConnection:Disconnect()
                end
            end
            
            if distance < 8 and IsTargeted() then
                Parry()
                positionConnection:Disconnect()
            end
        end)
        
        Ball.AncestryChanged:Connect(function()
            if not Ball.Parent then
                if positionConnection then
                    positionConnection:Disconnect()
                end
            end
        end)
    end)
end

-- Stop parry loop
function stopParryLoop()
    if parryConnection then
        parryConnection:Disconnect()
        parryConnection = nil
    end
    if spamConnection then
        spamConnection:Disconnect()
        spamConnection = nil
    end
end

