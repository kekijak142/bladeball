local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Stats = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
end)

-- Variables
local AutoParry = false
local AutoClicker = false
local SpamHit = false

-- Dynamic Ping Calculation
local function GetPing()
    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    return ping / 1000 -- Convert to seconds
end

-- Find Balls
local function GetBalls()
    local ballsFolder = workspace:FindFirstChild("Balls")
    if not ballsFolder then return {} end
    local balls = {}
    for _, v in pairs(ballsFolder:GetChildren()) do
        if v:IsA("BasePart") then table.insert(balls, v) end
    end
    return balls
end

-- Ultimate Parry Trigger
local function TriggerParry()
    pcall(function()
        -- Method 1: Try raw keypress (Executor specific)
        if keypress then
            keypress(0x46) -- 'F' key
            task.wait(0.01)
            keyrelease(0x46)
        end
        -- Method 2: Try Virtual Input (Standard fallback)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.01)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        
        -- Method 3: Mouse click fallback
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

-- Advanced Prediction Loop
RunService.Stepped:Connect(function()
    if not AutoParry or not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end

    local balls = GetBalls()
    local ping = GetPing()
    
    for _, ball in pairs(balls) do
        -- Check if ball is targeting us
        local target = ball:GetAttribute("target") or ball:GetAttribute("Target") or ball:GetAttribute("realTarget")
        
        if target == LocalPlayer.Name then
            local distance = (HRP.Position - ball.Position).Magnitude
            local velocity = ball.AssemblyLinearVelocity.Magnitude
            
            if velocity > 0 then
                -- Calculate time to impact, subtracting ping to react earlier
                local timeToImpact = (distance / velocity) - ping
                
                -- Dynamic threshold based on ball speed
                local parryWindow = 0.55
                if velocity > 100 then
                    parryWindow = 0.65 -- React sooner for fast balls
                end
                
                if timeToImpact <= parryWindow then
                    TriggerParry()
                end
            end
        end
    end
end)

