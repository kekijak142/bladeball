local function GetBalls()
    local BallsFolder = workspace:FindFirstChild("Balls")
    if not BallsFolder then return {} end

    local list = {}
    for _, ball in pairs(BallsFolder:GetChildren()) do
        if ball:IsA("BasePart") then
            table.insert(list, ball)
        end
    end
    return list
end

-------------------------------------------------
-- RUN AWAY AI SYSTEM
-------------------------------------------------
local function GetFarthestSpot()
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local bestPos = nil
    local bestScore = 0

    for i = 1, 40 do
        local offset = Vector3.new(
            math.random(-150, 150),
            math.random(-20, 40),
            math.random(-150, 150)
        )

        local pos = hrp.Position + offset
        local score = 0

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local enemyPos = p.Character.HumanoidRootPart.Position
                score = score + (pos - enemyPos).Magnitude
            end
        end

        if score > bestScore then
            bestScore = score
            bestPos = pos
        end
    end
    return bestPos, bestScore
end

local function FollowPath(destination)
    local hum = Character:FindFirstChildOfClass("Humanoid")
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true
    })

    pcall(function()
        path:ComputeAsync(hrp.Position, destination)

        if path.Status == Enum.PathStatus.Success then
            for _, waypoint in pairs(path:GetWaypoints()) do
                if not RunAway or not Character or not Character:FindFirstChild("Humanoid") then break end
                hum:MoveTo(waypoint.Position)
                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                hum.MoveToFinished:Wait()
            end
        end
    end)
end

local function RunAwayAI()
    if not RunAway then return end
    if not Character then return end
    if tick() - LastRun < RunCooldown then return end

    local target, score = GetFarthestSpot()
    if not target then return end

    local hrp = Character:FindFirstChild("HumanoidRootPart")
    local hum = Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if score > 400 and (hrp.Position - target).Magnitude < 10 then
        LastRun = tick()
        return
    end

    FollowPath(target)
    CurrentTarget = target
    LastRun = tick()
end

