-- Ascend Hub | Blade Ball Auto-Parry Integration
-- Loads your UI library directly from the GitHub raw link
local AscendUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/kekijak142/fg/refs/heads/main/gfh"))()

-- Core Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

-- Configuration Table (Linked directly to your UI)
local Config = {
    AutoParry = false,
    ParryDistance = 25,
    PingCompensation = false,
    PingMultiplier = 0.05
}

-- Target Remote
local ParryRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FireBall", 5)
if not ParryRemote then warn("[Ascend] 'FireBall' remote not found! Using virtual click fallback.") end

-- Auto Parry Logic Variables
local isParrying = false
local lastParryTime = 0
local parryCooldown = 0.4

local function getActiveBall()
    local ballsFolder = Workspace:FindFirstChild("Balls") or Workspace
    for _, obj in pairs(ballsFolder:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == "Ball" and obj.Velocity.Magnitude > 0 then
            return obj
        end
    end
    return nil
end

local function getPing()
    local ping = LocalPlayer:GetNetworkPing() * 2000 
    if ping > 300 then ping = 300 end 
    return ping
end

local function calculateThreat(ball)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    local rootPart = LocalPlayer.Character.HumanoidRootPart
    local distance = (rootPart.Position - ball.Position).Magnitude
    local velocity = ball.Velocity.Magnitude
    
    -- Check if ball is moving towards the player
    local directionToPlayer = (rootPart.Position - ball.Position).Unit
    local ballDirection = ball.Velocity.Unit
    local isApproaching = directionToPlayer:Dot(ballDirection) > 0.45
    
    if not isApproaching and distance > 15 then return false end
    
    -- Calculate dynamic range
    local dynamicParryRange = Config.ParryDistance + (velocity * 0.1)
    
    if Config.PingCompensation then
        dynamicParryRange = dynamicParryRange + (getPing() * Config.PingMultiplier)
    end
    
    if distance <= dynamicParryRange then
        return true
    end
    
    return false
end

local function executeParry()
    if isParrying or (tick() - lastParryTime) < parryCooldown then return end
    isParrying = true
    lastParryTime = tick()
    
    if ParryRemote then
        ParryRemote:FireServer()
    else
        -- Fallback Virtual Click
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end
    
    task.delay(0.2, function()
        isParrying = false
    end)
end

-- The Heartbeat Hook
RunService.Heartbeat:Connect(function()
    if not Config.AutoParry then return end
    
    local ball = getActiveBall()
    if ball then
        local isThreat = calculateThreat(ball)
        if isThreat then
            executeParry()
        end
    end
end)

---------------------------------------------------------
-- ASCEND UI CREATION
---------------------------------------------------------

local Window = AscendUI:CreateWindow("Ascend Hub | Blade Ball")

-- Combat Tab
local CombatTab = Window:CreateTab("Combat")
CombatTab:CreateSection("Auto Parry Settings")

CombatTab:CreateToggle("Enable Auto Parry", false, function(state)
    Config.AutoParry = state
end)

CombatTab:CreateSlider("Base Detection Range", 10, 60, 25, function(value)
    Config.ParryDistance = value
end)

CombatTab:CreateSection("Network & Predictions")

CombatTab:CreateToggle("Ping Compensation", false, function(state)
    Config.PingCompensation = state
end)

CombatTab:CreateSlider("Ping Aggressiveness", 1, 10, 5, function(value)
    -- Converts the 1-10 slider into a 0.01 to 0.1 multiplier for the math
    Config.PingMultiplier = value / 100 
end)

-- Misc Tab
local MiscTab = Window:CreateTab("Misc")
MiscTab:CreateSection("System")

MiscTab:CreateButton("Unload Ascend Hub", function()
    -- Disables script and destroys UI
    Config.AutoParry = false
    local coreGui = game:GetService("CoreGui"):FindFirstChild("AscendPremiumGUI")
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("AscendPremiumGUI")
    if coreGui then coreGui:Destroy() end
    if playerGui then playerGui:Destroy() end
end)
