-- Uses the executor's built-in mouse1click and keypress to bypass anti-cheat
local function TriggerParry()
    pcall(function()
        -- 0x46 is the virtual keycode for 'F'
        if keypress then
            keypress(0x46)
            task.wait(0.01)
            keyrelease(0x46)
        end
        if mouse1click then
            mouse1click()
        end
    end)
end

-------------------------------------------------
-- MAIN LOOP (HEARTBEAT)
-------------------------------------------------
RunService.Heartbeat:Connect(function()
    local balls = GetBalls()

    RunAwayAI()

    if AutoParry and Character then
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            for _, Ball in pairs(balls) do
                local velocity = Ball.AssemblyLinearVelocity.Magnitude
                local distance = (HRP.Position - Ball.Position).Magnitude
                local target = Ball:GetAttribute("target") or Ball:GetAttribute("Target")

                if velocity > 0 then
                    local prediction = distance / velocity
                    
                    if target == Player.Name and prediction <= 0.6 then
                        if tick() - LastParryTime > ParryCooldown then
                            LastParryTime = tick()
                            
                            TriggerParry()
                        end
                    end
                end
            end
        end
    end

    if SpamHit and Character then
        TriggerParry()
    end
end)

