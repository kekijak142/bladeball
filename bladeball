local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- ANTI-CHEAT BYPASS
--------------------------------------------------------------------------------
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

-- Block the game from kicking you
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if not checkcaller() and (method == "Kick" or method == "kick") then
        return
    end
    return oldNamecall(self, ...)
end)

-- Lie to the anti-cheat if it checks your speed or jump power
mt.__index = newcclosure(function(self, key)
    if not checkcaller() and self:IsA("Humanoid") then
        if key == "WalkSpeed" then
            return 16
        elseif key == "JumpPower" then
            return 50
        end
    end
    return oldIndex(self, key)
end)

setreadonly(mt, true)

--------------------------------------------------------------------------------
-- SCRIPT GLOBALS
--------------------------------------------------------------------------------
local _G = {
    AutoParry = false,
    AutoSpam = false,
    ParryRange = 25,
    SpamSpeed = 0.05,
    AutoFarm = false,
    WalkSpeed = 16,
    JumpPower = 50
}

-- Fetch and Load the AscendUI Library
local AscendUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/kekijak142/fg/refs/heads/main/gfh"))()

--------------------------------------------------------------------------------
-- INIT UI
--------------------------------------------------------------------------------
local Window = AscendUI:CreateWindow("Ascend Hub")

local InfoTab = Window:CreateTab("Info")
local FeaturesTab = Window:CreateTab("Features")
local FarmTab = Window:CreateTab("Farm")
local ExtraTab = Window:CreateTab("Extra")
local SettingsTab = Window:CreateTab("Settings")

--------------------------------------------------------------------------------
-- INFO TAB
--------------------------------------------------------------------------------
InfoTab:CreateSection("Welcome to Ascend Hub")
InfoTab:CreateButton("Copy Creator Tag", function()
    setclipboard("UI by kimi")
end)

--------------------------------------------------------------------------------
-- FEATURES TAB
--------------------------------------------------------------------------------
FeaturesTab:CreateSection("Combat")

FeaturesTab:CreateToggle("Auto Parry", false, function(state)
    _G.AutoParry = state
end)

FeaturesTab:CreateSlider("Parry Range (Studs)", 10, 50, 25, function(value)
    _G.ParryRange = value
end)

FeaturesTab:CreateToggle("Auto Spam (Click)", false, function(state)
    _G.AutoSpam = state
end)

--------------------------------------------------------------------------------
-- FARM TAB
--------------------------------------------------------------------------------
FarmTab:CreateSection("Farming Mechanics")

FarmTab:CreateToggle("Auto Farm (AFK)", false, function(state)
    _G.AutoFarm = state
end)

--------------------------------------------------------------------------------
-- EXTRA TAB
--------------------------------------------------------------------------------
ExtraTab:CreateSection("Local Player Mods")

ExtraTab:CreateSlider("WalkSpeed", 16, 200, 16, function(value)
    _G.WalkSpeed = value
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = _G.WalkSpeed
    end
end)

ExtraTab:CreateSlider("JumpPower", 50, 300, 50, function(value)
    _G.JumpPower = value
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.JumpPower = _G.JumpPower
    end
end)

--------------------------------------------------------------------------------
-- SETTINGS TAB
--------------------------------------------------------------------------------
SettingsTab:CreateSection("UI Settings")

SettingsTab:CreateButton("Destroy UI", function()
    if Window.ScreenGui then
        Window.ScreenGui:Destroy()
    end
end)

--------------------------------------------------------------------------------
-- CORE LOGIC (Exploits)
--------------------------------------------------------------------------------
local function doParry()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

RunService.RenderStepped:Connect(function()
    -- Spam Logic
    if _G.AutoSpam then
        doParry()
        task.wait(_G.SpamSpeed)
    end

    -- Parry Logic
    if _G.AutoParry then
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart

        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name == "Ball" and obj:IsA("Part") then
                local distance = (obj.Position - rootPart.Position).Magnitude
                
                if distance <= _G.ParryRange then
                    doParry()
                end
            end
        end
    end
end)
