-------------------------------------------------
-- PARRY VISUALIZER SYSTEM
-------------------------------------------------
local function FlashVisualizer()
    if VisualizerRing and not isFlashing then
        isFlashing = true
        VisualizerRing.Color = Color3.fromRGB(0, 255, 0) 
        task.delay(0.25, function() 
            isFlashing = false
            if VisualizerRing then
                VisualizerRing.Color = ESPColor
            end
        end)
    end
end

local function UpdateVisualizer()
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        if VisualizerRing then VisualizerRing:Destroy() VisualizerRing = nil end
        return
    end

    local hrp = Character.HumanoidRootPart

    if AutoParryVisualizer then
        if not VisualizerRing then
            VisualizerRing = Instance.new("Part")
            VisualizerRing.Name = "ParryVisualizerRing"
            VisualizerRing.Shape = Enum.PartType.Cylinder
            VisualizerRing.Size = Vector3.new(0.5, 25, 25) 
            VisualizerRing.Material = Enum.Material.ForceField
            VisualizerRing.Transparency = 0.5
            VisualizerRing.Anchored = true
            VisualizerRing.CanCollide = false
            VisualizerRing.Orientation = Vector3.new(0, 0, 90) 
            VisualizerRing.Parent = workspace
        end

        VisualizerRing.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)

        if not isFlashing then
            local targeted = false
            local activeBalls = GetBalls()
            
            for _, ball in pairs(activeBalls) do
                if ball:GetAttribute("target") == Player.Name then
                    targeted = true
                    break
                end
            end

            if targeted then
                VisualizerRing.Color = Color3.fromRGB(255, 75, 75) 
            else
                VisualizerRing.Color = ESPColor 
            end
        end
    else
        if VisualizerRing then
            VisualizerRing:Destroy()
            VisualizerRing = nil
        end
    end
end

-------------------------------------------------
-- GET NEAREST PLAYER
-------------------------------------------------
local function GetNearest()
    local nearest = nil
    local dist = math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude
            if d < dist then
                dist = d
                nearest = p
            end
        end
    end
    return nearest, dist
end

-------------------------------------------------
-- CAMERA CURVE
-------------------------------------------------
local function Curve()
    if not AutoCurve then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    local x = math.rad(math.random(-CurveStrength, CurveStrength))
    local y = math.rad(math.random(-CurveStrength, CurveStrength))

    cam.CFrame = cam.CFrame * CFrame.Angles(x, y, 0)
end

-------------------------------------------------
-- BALL ESP
-------------------------------------------------
local function UpdateESP()
    local balls = GetBalls()

    for ball, h in pairs(BallESPs) do
        if not table.find(balls, ball) or not BallESP then
            h:Destroy()
            BallESPs[ball] = nil
        end
    end

    if BallESP then
        for _, ball in pairs(balls) do
            if not BallESPs[ball] then
                local highlight = Instance.new("Highlight")
                highlight.FillColor = ESPColor
                highlight.OutlineColor = Color3.new(1, 1, 1)
                highlight.Adornee = ball
                highlight.Parent = ball
                BallESPs[ball] = highlight
            end
        end
    end
end

-------------------------------------------------
-- PLAYER BOX ESP
-------------------------------------------------
local function ToggleBoxESP(plr, state)
    if not plr.Character then return end

    if state then
        if PlayerBoxes[plr] then return end
        local box = Instance.new("SelectionBox")
        box.Adornee = plr.Character
        box.LineThickness = 0.05
        box.Color3 = ESPColor
        box.SurfaceTransparency = 1
        box.Parent = plr.Character
        PlayerBoxes[plr] = box
    else
        if PlayerBoxes[plr] then
            PlayerBoxes[plr]:Destroy()
            PlayerBoxes[plr] = nil
        end
    end
end

-------------------------------------------------
-- RUN AWAY AI SYSTEM
-------------------------------------------------
local function GetFarthestSpot()
    local hrp = Character and Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local bestPos = nil
    local bestScore = 0

    for i = 1, 40 do
        local offset = Vector3.new(
            math.random(-150, 150),
            math.random(-20, 40),
            math.random(-150, 150)
        )

        local pos = hrp.Position + offset
        local score = 0

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local enemyPos = p.Character.HumanoidRootPart.Position
                score = score + (pos - enemyPos).Magnitude
            end
        end

        if score > bestScore then
            bestScore = score
            bestPos = pos
        end
    end
    return bestPos, bestScore
end

local function FollowPath(destination)
    local hum = Character:FindFirstChildOfClass("Humanoid")
    local hrp = Character:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true
    })

    path:ComputeAsync(hrp.Position, destination)

    if path.Status == Enum.PathStatus.Success then
        for _, waypoint in pairs(path:GetWaypoints()) do
            hum:MoveTo(waypoint.Position)
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            hum.MoveToFinished:Wait()
        end
    end
end

local function RunAwayAI()
    if not RunAway then return end
    if not Character then return end
    if tick() - LastRun < RunCooldown then return end

    local target, score = GetFarthestSpot()
    if not target then return end

    local hrp = Character:FindFirstChild("HumanoidRootPart")
    local hum = Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if score > 400 and (hrp.Position - target).Magnitude < 10 then
        LastRun = tick()
        return
    end

    FollowPath(target)
    CurrentTarget = target
    LastRun = tick()
end

