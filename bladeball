local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- STRONG ANTI-CHEAT BYPASS
--------------------------------------------------------------------------------
-- Using hookmetamethod to safely block kicks without corrupting the metatable state
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if not checkcaller() and (method == "Kick" or method == "kick") then
        return -- Silently drop the kick request
    end
    return oldNamecall(self, ...)
end)

--------------------------------------------------------------------------------
-- SCRIPT GLOBALS
--------------------------------------------------------------------------------
local _G = {
    AutoParry = false,
    AutoSpam = false,
    ParryThreshold = 0.5, -- Time to impact in seconds
    SpamSpeed = 0.05,
    AutoFarm = false,
    WalkSpeed = 16,
    JumpPower = 50
}

-- Fetch and Load the AscendUI Library
local AscendUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/kekijak142/fg/refs/heads/main/gfh"))()

