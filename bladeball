-- SPAM HIT / AUTO CLICKER THREAD
-------------------------------------------------
task.spawn(function()
    while true do
        if AutoClicker or SpamHit then
            TriggerParry()
            task.wait(0.01) -- Insane spam speed
        else
            task.wait(0.1)
        end
    end
end)

